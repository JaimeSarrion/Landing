---
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { site, projects, statusLabel, jobs, education, stack } from '../data/content';

const mail = `mailto:${site.email}?subject=${encodeURIComponent('Full-stack role')}`;
const year = new Date().getFullYear();

// The statement's letters start scattered; offsets come from a fixed seed so every build is the same.
const statement = 'Interface, API, model.';
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280) * 2 - 1;
const letters = [...statement].map((ch, i) => ({
  ch,
  style: `--i:${i};--dx:${Math.round(rand() * 120)}px;--dy:${Math.round(40 + rand() * 60)}px;--rot:${Math.round(rand() * 35)}deg`,
}));

const agents = [
  { av: 'SR', name: 'Spec reader', what: 'Reads spec.md and plan.md', state: 'Done', cls: '' },
  { av: 'TP', name: 'Test planner', what: 'Splits the spec into test cases', state: 'Done', cls: '' },
  { av: 'TW', name: 'Test writer', what: 'Writes Playwright tests in parallel', state: 'Running', cls: 'chip--run' },
  { av: 'RV', name: 'Reviewer', what: 'Checks selectors and flaky waits', state: 'Queued', cls: 'chip--wait' },
  { av: 'QM', name: 'Context', what: 'qmd fetches only the files it needs', state: 'Done', cls: '' },
];
const planCode = [
  '<span class="k">const</span> plan = <span class="k">await</span> claude.messages.create({',
  '  model: <span class="s">"claude-sonnet-5-5"</span>,',
  '<span class="opt">  max_tokens: <span class="s">1024</span>,</span>',
  '  system: coachPrompt,',
  '  messages: history,',
  '});',
].join('\n');
const check = '<svg viewBox="0 0 10 10"><path d="M2 5.2 4.2 7.4 8 3"/></svg>';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{site.title}</title>
  <meta name="description" content={site.description} />
  <link rel="canonical" href="https://jsarrion.es/" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={site.title} />
  <meta property="og:description" content="Frontend lead at Qida, moving into full-stack AI engineering. Projects, experience and contact." />
  <meta property="og:url" content="https://jsarrion.es/" />
  <meta property="og:image" content="https://jsarrion.es/share.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#1c1c1c" />
  <meta name="page-type" content="software" />
  <meta name="site-kind" content="software" />
  <link rel="icon" href="favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="fonts/onest.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="#top">{site.name}</a>
    <nav class="nav__links" aria-label="Main" id="menu">
      <a href="#projects">Projects</a>
      <a href="#ai">AI</a>
      <a href="#experience">Experience</a>
      <a href="#stack">Stack</a>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={mail}>Email Jaime</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu">
        <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 6h14M2 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>

<main id="top">
  <section class="hero" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="grid hero__grid">
        <div class="hero__text">
          <h1 id="hero-h">Frontend lead building <span class="nb">full-stack</span> AI products</h1>
          <p class="lead">I lead Qida’s five-person frontend team and built the agent orchestrator that writes our Playwright tests. Next, I want the whole stack: interface, API, data and model calls.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={mail}>Email Jaime<Arrow /></a>
            <a class="btn btn--secondary" href="#projects">See the projects</a>
          </div>
          <p class="hero__proof">Based in Valencia, shipping web products since 2017. Before Qida: Bravo Capital, Rated Power, and apps for Santander and Bizum.</p>
        </div>

        <div class="hero__art" role="img" aria-label="Mock-up of the test orchestrator: five agents read a spec, plan tests, write Playwright tests and review them, and a pull request is ready.">
          <div class="hero__win win" data-ui="window" aria-hidden="true">
            <div class="win__bar"><span class="win__dots"><i></i><i></i><i></i></span><span>test-orchestrator · web-app</span></div>
            <div class="win__body">
              <div class="win__side">
                <span class="is-on"><i></i>Runs</span><span><i></i>Specs</span><span><i></i>Agents</span><span><i></i>Coverage</span>
                <span class="win__label">Repos</span><span><i></i>web-app</span><span><i></i>ui-kit</span>
              </div>
              <div class="win__main">
                <div class="win__head"><b>Spec 014 · checkout form</b><span class="win__meta">5 agents</span></div>
                <div class="rows">
                  {agents.map((a) => (
                    <div class="row">
                      <span class="row__av">{a.av}</span>
                      <div><b>{a.name}</b><small class="row__what">{a.what}</small></div>
                      <span class={`chip ${a.cls}`}>{a.state}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <div class="hero__note note" aria-hidden="true">
            <div class="note__head"><b>Pull request ready</b><span class="chip">Review</span></div>
            <div class="note__line"><i set:html={check} /><span><b>spec.md</b> split into test cases</span></div>
            <div class="note__line"><i set:html={check} /><span><b>Playwright</b> tests written</span></div>
            <div class="note__line"><i set:html={check} /><span>Reviewer found <b>no flaky waits</b></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-h">Projects I build and run. <span class="muted">Designed, coded and deployed by me.</span></h2>
      </div>
      <div class="frame">
        <div class="win">
          <div class="win__bar"><span class="win__dots"><i></i><i></i><i></i></span><span>jsarrion.es · projects</span></div>
          <div class="app">
            <div class="app__list" role="tablist" aria-label="Projects">
              {projects.map((p, i) => (
                <button class="app__item" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                  <b>{p.name}</b><span class={`dot dot--${p.status}`} aria-hidden="true"></span>
                  <small>{p.short}</small>
                </button>
              ))}
            </div>
            {projects.map((p, i) => (
              <div class="app__panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
                <div class="app__top">
                  <h3>{p.name}</h3>
                  <span class={`chip ${p.status === 'building' ? 'chip--run' : p.status === 'archived' ? 'chip--wait' : ''}`}>{statusLabel[p.status]}</span>
                  <span class="year">{p.year}</span>
                </div>
                <p>{p.body}</p>
                <dl class="facts">{p.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
                {p.stack.length > 0 && <ul class="tags" aria-label="Stack">{p.stack.map((s) => <li>{s}</li>)}</ul>}
                {(p.live || p.code) && (
                  <div class="app__links">
                    {p.live && <a class="go link" href={p.live} target="_blank" rel="noopener">Open {p.name}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5 8.5 3.5M4 3.5h4.5V8" /></svg></a>}
                    {p.code && <a class="alt link" href={p.code} target="_blank" rel="noopener">Read the code</a>}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="ai" class="g2" aria-labelledby="ai-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ai-h">AI tooling in my daily work. <span class="muted">Agents write the tests, specs come first.</span></h2>
      </div>
      <div class="cards">
        <article class="card">
          <h3>Sends each test task to its own agent</h3>
          <p>At Qida I built an orchestrator that gives planning, writing and review to separate agents, not one huge prompt.</p>
          <div class="panel" aria-hidden="true">
            <svg class="dia" viewBox="0 0 520 220">
              <path class="ln" d="M120 110H200" /><path class="ln" d="M320 110C360 110 360 40 400 40" /><path class="ln" d="M320 110H400" /><path class="ln" d="M320 110C360 110 360 180 400 180" />
              <path class="pulse" d="M120 110H200" /><path class="pulse" d="M320 110C360 110 360 40 400 40" /><path class="pulse" d="M320 110H400" /><path class="pulse" d="M320 110C360 110 360 180 400 180" />
              <rect x="0" y="86" width="120" height="48" rx="10" /><text x="20" y="108">spec.md</text><text class="sub" x="20" y="124">Spec Kit</text>
              <rect class="hub" x="200" y="80" width="120" height="60" rx="12" /><text class="hub-t" x="222" y="106">Orchestrator</text><text class="hub-t sub" x="222" y="124" style="fill:#c9d3c6">dispatches</text>
              <rect x="400" y="20" width="120" height="40" rx="10" /><text x="418" y="45">Planner</text>
              <rect x="400" y="90" width="120" height="40" rx="10" /><text x="418" y="115">Writer</text>
              <rect x="400" y="160" width="120" height="40" rx="10" /><text x="418" y="185">Reviewer</text>
            </svg>
          </div>
        </article>
        <article class="card">
          <h3>Writes the spec before the code</h3>
          <p>With GitHub Spec Kit, product and engineering agree on the spec, the plan and the tasks before anyone opens an editor.</p>
          <div class="panel" aria-hidden="true">
            <div class="frag" data-ui="fragment">
              <div class="frag__bar">specs</div>
              <div class="frag__body tree">
                <span>014-checkout-form/</span>
                <span class="in1">spec.md<em>Approved</em></span>
                <span class="in1">plan.md<em>Approved</em></span>
                <span class="in1 is-on">tasks.md<em>12 tasks</em></span>
                <span class="in1 hide-sm">contracts/</span>
                <span class="in2">checkout.yaml</span>
              </div>
            </div>
          </div>
        </article>
        <article class="card">
          <h3>Gives agents only the context they need</h3>
          <p>qmd indexes the repo, so an agent pulls only the files that matter. Fewer tokens, sharper answers.</p>
          <div class="panel" aria-hidden="true">
            <div class="frag" data-ui="fragment">
              <div class="frag__bar">terminal</div>
              <div class="frag__body">
                <div class="code"><span class="c">$</span> qmd query <span class="s">"checkout validation"</span></div>
                <div class="hits">
                  <span>useCheckoutForm.ts<em>0.91</em></span>
                  <span>schema/checkout.ts<em>0.87</em></span>
                  <span>CheckoutForm.test.tsx<em>0.74</em></span>
                </div>
              </div>
            </div>
          </div>
        </article>
        <article class="card">
          <h3>Calls Claude from my own products</h3>
          <p>Torsion runs on the Claude API, and Entrena’s next module asks Claude to draft training plans.</p>
          <div class="panel" aria-hidden="true">
            <div class="frag" data-ui="fragment">
              <div class="frag__bar">server/plan.ts</div>
              <div class="frag__body"><div class="code" set:html={planCode} /></div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="statement" aria-label="Interface, API, model">
    <div class="wrap">
      <p class="statement__big" aria-label={statement}>{letters.map((l) => <span class="ch" aria-hidden="true" style={l.style}>{l.ch}</span>)}</p>
      <p class="statement__sub">Nine years on the interface. Now the API, the data and the model calls behind it.</p>
      <ol class="layers" aria-label="The three layers">
        <li><ToolIcon slug="react" name="React" /><span class="label">Interface</span><code>&lt;PlanCard plan=&#123;plan&#125; /&gt;</code></li>
        <li><ToolIcon slug="nodedotjs" name="Node.js" /><span class="label">API</span><code>POST /api/plans</code></li>
        <li><ToolIcon slug="claude" name="Claude" /><span class="label">Model</span><code>claude.messages.create()</code></li>
      </ol>
    </div>
  </section>

  <section id="experience" class="ground-surface g2m" aria-labelledby="experience-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="experience-h">Experience. <span class="muted">From mobile apps to leading a frontend team.</span></h2>
      </div>
      <ol class="jobs">
        {jobs.map((j) => (
          <li class="job">
            <div><h3>{j.role}</h3><p class="co">{j.company}</p></div>
            <p>{j.line}</p>
            <time>{j.dates}</time>
          </li>
        ))}
      </ol>
      <p class="edu">{education.map((e) => <span>{e}</span>)}</p>
    </div>
  </section>

  <section id="stack" class="ground-surface g2m" aria-labelledby="stack-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="stack-h">Stack. <span class="muted">Front to back, plus the AI tooling.</span></h2>
      </div>
      <div class="stack">
        {stack.map((g) => (
          <div>
            <h3>{g.group}</h3>
            <ul class="tools">
              {g.tools.map((t) => <li class="tool"><ToolIcon slug={t.icon} name={t.name} />{t.name}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="legal-note">Product names and logos are trademarks of their owners.</p>
    </div>
  </section>
</main>

<footer class="closing" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="close">
      <h2 id="close-h">Open to <span class="nb">full-stack</span> roles with AI</h2>
      <p>Tell me about the product, the team and the stack.</p>
      <a class="btn btn--primary close__btn" href={mail}>Email Jaime<Arrow /></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="footer__me">
          <a class="nav__logo" href="#top">{site.name}</a>
          <p>Lead Frontend Developer at Qida, in Valencia.</p>
        </div>
        <div class="footer__col">
          <h3>On this page</h3>
          <ul><li><a href="#projects">Projects</a></li><li><a href="#ai">AI</a></li><li><a href="#experience">Experience</a></li><li><a href="#stack">Stack</a></li></ul>
        </div>
        <div class="footer__col">
          <h3>Elsewhere</h3>
          <ul><li><a href={site.github} rel="me">GitHub</a></li><li><a href={site.linkedin} rel="me">LinkedIn</a></li></ul>
        </div>
      </div>
      <div class="footer__legal"><span>© {year} {site.name}</span><span>No cookies, no tracking.</span></div>
    </div>
  </div>
</footer>

<script>
  // Projects: one tab open at a time, arrow keys move between tabs.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const open = (t: HTMLButtonElement) => {
    for (const x of tabs) {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    }
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => open(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const n = tabs[(i + d + tabs.length) % tabs.length];
      open(n);
      n.focus();
    });
  });

  // Phone and tablet menu.
  const nav = document.querySelector('.nav')!;
  const toggle = nav.querySelector<HTMLButtonElement>('.nav__toggle')!;
  const set = (on: boolean) => { nav.classList.toggle('is-open', on); toggle.setAttribute('aria-expanded', String(on)); };
  toggle.addEventListener('click', () => set(!nav.classList.contains('is-open')));
  nav.querySelectorAll('.nav__links a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
</body>
</html>
